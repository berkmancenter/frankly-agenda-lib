{
  "compilerOptions": {
    "target": "es2021",
    "module": "ESNext",
    "moduleResolution": "Node",
    "declaration": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "emitDeclarationOnly": false,
    "sourceMap": true,
  },
  "include": [
    "src/**/*"
  ]
}